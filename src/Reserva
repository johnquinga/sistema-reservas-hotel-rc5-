package quinga_chalavarri;

import java.time.LocalDate;
import java.time.temporal.ChronoUnit;
import java.util.UUID;

/**
 * Clase Reserva que maneja las reservas del hotel
 */
public class Reserva {
    private String id;
    private Cliente cliente;
    private Habitacion habitacion;
    private LocalDate fechaInicio;
    private LocalDate fechaFin;
    private EstadoReserva estado;
    private double precioTotal;
    private LocalDate fechaCreacion;

    // Constructor
    public Reserva(Cliente cliente, Habitacion habitacion, LocalDate fechaInicio, LocalDate fechaFin) {
        this.id = UUID.randomUUID().toString().substring(0, 8);
        this.cliente = cliente;
        this.habitacion = habitacion;
        this.fechaInicio = fechaInicio;
        this.fechaFin = fechaFin;
        this.estado = EstadoReserva.PENDIENTE;
        this.fechaCreacion = LocalDate.now();

        // Calcular precio total
        calcularPrecioTotal();

        // Reservar la habitación
        habitacion.reservar(fechaInicio, fechaFin);

        // Agregar reserva al historial del cliente
        cliente.agregarReserva(this);
    }

    // Método para calcular precio total
    private void calcularPrecioTotal() {
        long diasEstadia = ChronoUnit.DAYS.between(fechaInicio, fechaFin);
        this.precioTotal = diasEstadia * habitacion.getPrecio();
    }

    // Método para confirmar reserva
    public void confirmar() {
        this.estado = EstadoReserva.CONFIRMADA;
    }

    // Método para cancelar reserva
    public void cancelar() {
        this.estado = EstadoReserva.CANCELADA;
        habitacion.liberar();
    }

    // Método para completar reserva
    public void completar() {
        this.estado = EstadoReserva.COMPLETADA;
        habitacion.liberar();
    }

    // Método para obtener duración de la estadía
    public long getDuracionEstadia() {
        return ChronoUnit.DAYS.between(fechaInicio, fechaFin);
    }

    // Getters
    public String getId() { return id; }
    public Cliente getCliente() { return cliente; }
    public Habitacion getHabitacion() { return habitacion; }
    public LocalDate getFechaInicio() { return fechaInicio; }
    public LocalDate getFechaFin() { return fechaFin; }
    public EstadoReserva getEstado() { return estado; }
    public double getPrecioTotal() { return precioTotal; }
    public LocalDate getFechaCreacion() { return fechaCreacion; }

    @Override
    public String toString() {
        return String.format(
                "Reserva [ID: %s] - Cliente: %s - Habitación: %d (%s) - " +
                        "Fecha: %s a %s (%d días) - Estado: %s - Total: $%.2f",
                id, cliente.getNombreCompleto(), habitacion.getNumero(),
                habitacion.getTipo().getNombre(), fechaInicio, fechaFin,
                getDuracionEstadia(), estado, precioTotal
        );
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (obj == null || getClass() != obj.getClass()) return false;
        Reserva reserva = (Reserva) obj;
        return id.equals(reserva.id);
    }

    @Override
    public int hashCode() {
        return id.hashCode();
    }
}
